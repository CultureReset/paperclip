# NEXT GENT server settings. Copy to .env and fill in. Never commit .env.

# ── Database: Supabase project "Saas" (ref mtjxlyncokedaduvzgmp, us-east-2) ──
# Supabase → Connect → "Session pooler" (port 5432). Not the transaction pooler
# on 6543: Paperclip uses prepared statements. The direct db.<ref>.supabase.co
# host is IPv6-only, which many hosts can't reach. Copy the string from the
# dashboard exactly; the pooler host can be aws-0-… or aws-1-….
DATABASE_URL=postgres://postgres.mtjxlyncokedaduvzgmp:YOUR-DB-PASSWORD@aws-0-us-east-2.pooler.supabase.com:5432/postgres?sslmode=require

# ── The address people type in their browser. Must be exact, https in production.
PAPERCLIP_PUBLIC_URL=https://app.example.com

# ── Secrets. Generate each one with:  openssl rand -hex 32
# Changing BETTER_AUTH_SECRET logs everyone out. Changing the agent secret
# invalidates in-flight agent runs. Set once, keep them in your secret manager.
BETTER_AUTH_SECRET=
PAPERCLIP_AGENT_JWT_SECRET=
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=

# ── Sign-ups. "false" = anyone can create an account and gets their own
# workspace. Set "true" to close sign-ups (invites only).
PAPERCLIP_AUTH_DISABLE_SIGN_UP=false

# ── AI key: set it ONCE here. Every agent the server runs, in every customer
# workspace, inherits it. No per-agent or per-workspace keys needed.
#   Anthropic  → Claude agents        OpenAI → Codex agents
#   OpenRouter → OpenCode agents (model must start with openrouter/)
#   xAI        → Grok agents
# A workspace can still add its own key in the dashboard (Apps → AI connection),
# which overrides this one for that workspace.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# XAI_API_KEY=

# ── NEXT GENT wiring (docs/api/nextgent.md). Every value is optional in dev:
# an unset one turns its feature off with a warning; nothing has a built-in
# default address, name or limit.

# gcr-api-clean, the business-data API. Paperclip calls its /api/nextgent/*
# endpoints signed, and writes this URL into the business-data plugin config.
# GCR_API_URL=
# Shared HMAC secret for service-to-service calls, the same value in
# gcr-api-clean. Generate with: openssl rand -hex 32
# NEXTGENT_SERVICE_SECRET=

# Private key (PEM, Ed25519 or RSA) that signs the short-lived business tokens
# screens send to gcr-api-clean. Its public half is served at
# /.well-known/jwks.json. Unset in dev: a temporary key is generated at start
# (tokens stop verifying on restart). Single-line env files may use \n.
#   openssl genpkey -algorithm ed25519
# NEXTGENT_JWT_PRIVATE_KEY=
# Business-token lifetime in seconds; capped at 300 by the contract.
# NEXTGENT_BUSINESS_TOKEN_TTL_SECONDS=300
# PAPERCLIP_PUBLIC_URL (above / in your deployment) is the tokens' issuer.

# LiteLLM model gateway. At sign-up each company gets its own key
# (/key/generate) and its agent runs use it instead of the server-wide AI key.
# Unset: agents keep using the server-wide key (dev only).
# LITELLM_URL=
# LITELLM_MASTER_KEY=
# Optional budget per company key, in LiteLLM's units, and its window (e.g. 30d).
# LITELLM_COMPANY_BUDGET=
# LITELLM_BUDGET_DURATION=

# The assistant agent created for every new company at sign-up. Unset name:
# no assistant is created. Adapter falls back to
# PAPERCLIP_TEAMS_CATALOG_DEFAULT_ADAPTER_TYPE.
# NEXTGENT_ASSISTANT_NAME=
# NEXTGENT_ASSISTANT_ADAPTER_TYPE=
# Optional path to the AGENTS.md instructions it starts with.
# NEXTGENT_ASSISTANT_INSTRUCTIONS_FILE=

# Company that receives conversations gcr-api-clean sends for "nextgent"
# (the concierge number), i.e. NEXT GENT's own company id.
# NEXTGENT_PLATFORM_COMPANY_ID=

# Store pricing vocabulary shown in the admin console (GET /api/store/admin/meta),
# comma-separated. Prices themselves are set per item and billed by
# gcr-api-clean. NEXTGENT_STORE_CURRENCY is used when a price is set without
# a currency (three-letter ISO code).
# NEXTGENT_STORE_PRICE_MODELS=
# NEXTGENT_STORE_PRICE_INTERVALS=
# NEXTGENT_STORE_CURRENCY=

# The owner app's address. Invites created with an email address are emailed
# (through gcr-api-clean) with the link OWNER_APP_URL/#/invite/<token>. Unset:
# invites are still created; the response says the email was not sent.
# OWNER_APP_URL=
