DATABASE_URL=postgres://paperclip:paperclip@localhost:5432/paperclip
PORT=3100
SERVE_UI=false
BETTER_AUTH_SECRET=paperclip-dev-secret
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=paperclip-dev-tool-action-signing-secret-change-me

# Optional Paperclip ID Gmail OAuth broker. Enroll the instance first; keep both
# private keys in the deployment secret manager. HTTP base URLs must be loopback.
# PAPERCLIP_ID_CONNECTOR_BASE_URL=http://localhost:3000
# PAPERCLIP_ID_CONNECTOR_ENVIRONMENT=development
# PAPERCLIP_ID_CONNECTOR_INSTANCE_ID=inst_example
# PAPERCLIP_ID_CONNECTOR_SIGN_PRIVATE_KEY=
# PAPERCLIP_ID_CONNECTOR_SEAL_PRIVATE_KEY=

# Process-wide protection for expensive full-tree workspace Git scans.
# PAPERCLIP_WORKSPACE_GIT_SCAN_CONCURRENCY=2
# PAPERCLIP_WORKSPACE_GIT_SCAN_QUEUE_CAPACITY=32
# PAPERCLIP_WORKSPACE_GIT_SCAN_TIMEOUT_MS=8000
# PAPERCLIP_WORKSPACE_GIT_SCAN_CACHE_TTL_MS=10000

# HTTP adapters may call public HTTP(S) origins by default. Opt trusted private
# origins in explicitly; entries are exact origins (scheme, host, and port).
# PAPERCLIP_HTTP_ADAPTER_PRIVATE_ENDPOINT_ALLOWLIST=http://hooks.internal.example:8080

# Discord webhook for daily merge digest (scripts/discord-daily-digest.sh)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ── NEXT GENT wiring (docs/api/nextgent.md). Every value is optional in dev:
# an unset one turns its feature off with a warning; nothing has a built-in
# default address, name or limit.

# gcr-api-clean, the business-data API. Paperclip calls its /api/nextgent/*
# endpoints signed, and writes this URL into the business-data plugin config.
# GCR_API_URL=
# Shared HMAC secret for service-to-service calls, the same value in
# gcr-api-clean. Generate with: openssl rand -hex 32
# NEXTGENT_SERVICE_SECRET=
# Switch-over only: also accept the previous signature format (no nonce, so
# replayable for 300 s) on inbound calls. Off unless set to true.
# NEXTGENT_ACCEPT_LEGACY_SIGNATURES=false

# Private key (PEM, Ed25519 or RSA) that signs the short-lived business tokens
# screens send to gcr-api-clean. Its public half is served at
# /.well-known/jwks.json. Required in production (NODE_ENV=production): a
# server with gcr-api-clean wired refuses to start without it, and no token is
# ever signed with a generated key there. Unset in dev/test only: a temporary
# key is generated at start (tokens stop verifying on restart). Single-line
# env files may use \n.
#   openssl genpkey -algorithm ed25519
# NEXTGENT_JWT_PRIVATE_KEY=
# Business-token lifetime in seconds; capped at 300 by the contract.
# NEXTGENT_BUSINESS_TOKEN_TTL_SECONDS=300
# PAPERCLIP_PUBLIC_URL (above / in your deployment) is the tokens' issuer.

# LiteLLM model gateway. At sign-up each company gets its own key
# (/key/generate) and its agent runs use it instead of the server-wide AI key.
# Unset: agents keep using the server-wide key (dev only).
# LITELLM_URL=
# LITELLM_MASTER_KEY=
# Optional budget per company key, in LiteLLM's units, and its window (e.g. 30d).
# LITELLM_COMPANY_BUDGET=
# LITELLM_BUDGET_DURATION=

# The assistant agent created for every new company at sign-up. Unset name:
# no assistant is created. Adapter falls back to
# PAPERCLIP_TEAMS_CATALOG_DEFAULT_ADAPTER_TYPE.
# NEXTGENT_ASSISTANT_NAME=
# NEXTGENT_ASSISTANT_ADAPTER_TYPE=
# Optional path to the AGENTS.md instructions it starts with.
# NEXTGENT_ASSISTANT_INSTRUCTIONS_FILE=

# Company that receives conversations gcr-api-clean sends for "nextgent"
# (the concierge number), i.e. NEXT GENT's own company id.
# NEXTGENT_PLATFORM_COMPANY_ID=

# Store pricing vocabulary shown in the admin console (GET /api/store/admin/meta),
# comma-separated. Prices themselves are set per item and billed by
# gcr-api-clean. NEXTGENT_STORE_CURRENCY is used when a price is set without
# a currency (three-letter ISO code).
# NEXTGENT_STORE_PRICE_MODELS=
# NEXTGENT_STORE_PRICE_INTERVALS=
# NEXTGENT_STORE_CURRENCY=

# ── Automations (the step runner, Step 7.1, DECISIONS #82) ───────────────
# Every value has a default; unset means that default, not "off".
# AUTOMATION_DEFAULT_TIMEZONE=UTC       schedules read in this zone when neither the business nor the trigger names one (falls back to DEFAULT_TIMEZONE)
# AUTOMATION_WAIT_MAX_MINUTES=0         longest a wait step may ask for; 0 = no limit
# AUTOMATION_RESUME_LIMIT=100           due waits resumed per scheduler tick
# AUTOMATION_OUTPUT_BUDGET=8000         characters kept of a step's output in the run log
# AUTOMATION_SCRIPT_TIMEOUT_MS=2000     the admin-only script step's time limit
# AUTOMATION_HTTP_TIMEOUT_MS=10000      the admin-only http.request step's time limit
# AUTOMATION_AI_MODEL=                  model an ai.prompt step asks the company's gateway for (AUTOMATION_AI_MODEL_<TASK> per task); unset: the step fails with the reason
# OWNER_AUTOMATIONS_PATH=               path under OWNER_APP_URL linked from "an automation did not finish" notices

# ── Owner notifications (DECISIONS #85) ──────────────────────────────────
# Texts go through gcr-api-clean's signed POST /api/nextgent/platform-text (one telephony integration).
# Email goes through the adapter PLATFORM_MAIL_PROVIDER names; unset: email is off and every send is logged as skipped.
# PLATFORM_MAIL_PROVIDER=               brevo | log
# PLATFORM_MAIL_API_KEY=
# PLATFORM_MAIL_API_URL=                the provider's endpoint; each adapter documents its default
# PLATFORM_MAIL_FROM=                   sender address
# PLATFORM_MAIL_FROM_NAME=
# PLATFORM_ADMIN_EMAIL=                 where platform notices (notifyPlatform) go
# PLATFORM_PHONE_DEFAULT_COUNTRY_CODE=1 country code assumed for a national number

# ── Entitlement and prices (DECISIONS #83) ───────────────────────────────
# ENTITLEMENT_SOURCE=gcr                gcr (default until Phase C): the store asks gcr-api-clean and forwards prices;
#                                       paperclip: plans, grants and company plans here decide, store_items prices are authoritative

# Devices: a computer or phone is "online" when gcr-api-clean's status push
# saw it within this many seconds. Unset: online is reported as unknown and
# screens show the last sighting only.
# NEXTGENT_DEVICE_ONLINE_SECONDS=180

# The owner app's address. Invites created with an email address are emailed
# (through gcr-api-clean) with the link OWNER_APP_URL/#/invite/<token>. Unset:
# invites are still created; the response says the email was not sent.
# OWNER_APP_URL=
