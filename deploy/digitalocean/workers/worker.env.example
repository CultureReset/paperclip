# One business's workers. Copy to businesses/<id>.env (never committed) and
# pass it with --env-file. Placeholders only; WORKERS.md says where each
# value comes from.

# Short, stable, lowercase id for this business's workers: names the compose
# project, its network (nextgent-worker-<id>) and its hostnames. Use the
# Paperclip company's url key or a short slug, never something secret.
WORKER_ID=acme

# ── Images (pinned)
HERMES_VERSION=0.0.0
HERMES_IMAGE=nextgent/hermes-gateway:0.0.0
OPENCLAW_IMAGE=nextgent/openclaw:vYYYY.M.D
# From the pinned OpenClaw ref's docker-compose.yml (openclaw-gateway command).
OPENCLAW_GATEWAY_COMMAND=node dist/index.js gateway --bind lan --port 18789

# ── Ports inside the business's network (not published on the host)
HERMES_PORT=8642
OPENCLAW_PORT=18789

# ── Sizes for this business
HERMES_MEM_LIMIT=1g
HERMES_CPUS=1.0
OPENCLAW_MEM_LIMIT=1g
OPENCLAW_CPUS=1.0
WORKER_PIDS_LIMIT=512

# ── Keys
# Paperclip -> Hermes gateway key (also stored in the Paperclip agent's
# adapter config as apiKey).            openssl rand -hex 32
HERMES_API_SERVER_KEY=
# Paperclip -> OpenClaw gateway token (adapter config token).  openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=
# Models through LiteLLM only: the public model API and THIS company's
# LiteLLM key (the one Paperclip generated at sign-up; LiteLLM admin UI ->
# Virtual Keys, filter by metadata.company_id).
WORKER_LLM_BASE_URL=https://llm.example.com/v1
WORKER_LLM_KEY=
