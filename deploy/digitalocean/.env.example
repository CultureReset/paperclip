# NEXT GENT always-on Droplet: compose-level settings.
#
#   cp .env.example .env        # this file: domains, images, sizes, shared secrets
#   cp ../../nextgent/.env.example env/paperclip.env
#   cp <gcr-api-clean checkout>/.env.example env/gcr-api.env
#   cp env/litellm.env.example env/litellm.env
#
# Never commit .env or env/*.env (see .gitignore here). Every value below is a
# placeholder; SETTINGS.md says where each real value comes from.
# Values set here win over the same name in env/*.env, because docker-compose.yml
# passes them in `environment:`, which overrides `env_file:`.

# ── Domains (DNS A records point at the Droplet's reserved IP; Caddy gets
#    certificates for each automatically). No scheme, no path.
PAPERCLIP_DOMAIN=app.example.com
GCR_API_DOMAIN=api.example.com
# OPTIONAL, decision needed: only if you publish LiteLLM's model API
# (caddy-sites/litellm-public.caddy.example). Leave empty otherwise.
LITELLM_DOMAIN=
# The email Let's Encrypt sends expiry warnings to.
ACME_EMAIL=ops@example.com
# With that option only: who may open LiteLLM's admin UI through Caddy
# (space-separated CIDRs).
LITELLM_ADMIN_CIDRS=

# ── Images. Pin versions; never deploy a moving tag.
# Paperclip is built from this repo (nextgent/docker-compose.yml) and tagged
# with this name; set it to a registry digest instead to skip building.
PAPERCLIP_IMAGE=nextgent/paperclip:local
# gcr-api-clean is built from its own checkout with the inline Dockerfile in
# docker-compose.yml, on this Node base image.
GCR_API_NODE_IMAGE=node:24-bookworm-slim
GCR_API_IMAGE=nextgent/gcr-api-clean:local
# Path to the gcr-api-clean checkout on the Droplet, relative to this file
# or absolute. Clone it on the branch you are releasing.
GCR_API_CLEAN_SRC=../../../gcr-api-clean
# LiteLLM proxy image (https://github.com/BerriAI/litellm/pkgs/container/litellm).
LITELLM_IMAGE=ghcr.io/berriai/litellm:main-vX.Y.Z-stable
CADDY_IMAGE=caddy:2-alpine
CRON_IMAGE=alpine:3

# ── Sizes (per container). Example values only: sizing is the owner's
#    choice (STEPS.md, "Decisions").
PAPERCLIP_MEM_LIMIT=4g
PAPERCLIP_CPUS=2.0
GCR_API_MEM_LIMIT=1g
GCR_API_CPUS=1.0
LITELLM_MEM_LIMIT=1g
LITELLM_CPUS=1.0
CADDY_MEM_LIMIT=256m
CRON_MEM_LIMIT=64m

# ── Ports inside the private compose network (nothing is published except
#    Caddy's 80/443).
GCR_API_PORT=3000
LITELLM_PORT=4000

# ── Paperclip behind one proxy hop (Caddy). See server/src/middleware/trust-proxy.ts.
PAPERCLIP_TRUST_PROXY=1

# ── Shared secrets: set ONCE here, injected into every service that needs them.
# HMAC for Paperclip <-> gcr-api-clean signed calls (CONTRACT §3).
#   openssl rand -hex 32
NEXTGENT_SERVICE_SECRET=
# LiteLLM admin key. Paperclip makes one key per company with it; gcr-api-clean
# makes per-company keys for live calls and pulls spend with it.
# Must start with "sk-".  echo "sk-$(openssl rand -hex 32)"
LITELLM_MASTER_KEY=
# Bearer token the cron container sends to gcr-api-clean's cron routes
# (only used with the gcr-crons profile; also set on Vercel if crons stay there).
#   openssl rand -hex 32
CRON_SECRET=
