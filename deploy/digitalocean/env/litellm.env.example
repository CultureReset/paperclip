# LiteLLM proxy settings. Copy to env/litellm.env. Never commit the copy.
# LITELLM_MASTER_KEY is NOT here: it is set once in ../.env and injected.

# Postgres for LiteLLM's own tables (virtual keys, budgets, spend). Required:
# per-company keys (/key/generate) need a database. DECISION NEEDED (owner),
# where it lives:
#   option 1: the Saas Supabase project's SESSION pooler string (port 5432)
#             with its own schema (?schema=litellm), apart from Paperclip's
#   option 2: a separate database
# The example below shows option 1's shape.
DATABASE_URL=postgresql://postgres.<saas-ref>:<db-password>@<pooler-host>:5432/postgres?schema=litellm&sslmode=require

# Encrypts provider credentials LiteLLM stores in its database. Set once and
# never change it (stored credentials become unreadable).
#   echo "sk-$(openssl rand -hex 32)"
LITELLM_SALT_KEY=

# The admin UI login (served under /ui, reachable only from LITELLM_ADMIN_CIDRS).
UI_USERNAME=
UI_PASSWORD=

# ── Which real model each tier calls (litellm/config.yaml reads these).
# Agents and gcr-api-clean ask for the tier name (fast / reasoning / coding),
# never a vendor model, so a model is changed here without touching agents.
# Format: <provider>/<model id>, as LiteLLM's provider docs spell it.
LITELLM_MODEL_FAST=<provider>/<model-id>
LITELLM_MODEL_REASONING=<provider>/<model-id>
LITELLM_MODEL_CODING=<provider>/<model-id>

# ── Provider keys: set the ones your tier models use. LiteLLM reads these
# standard names itself. Only LiteLLM holds provider keys.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# XAI_API_KEY=
